<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".ui.main.MainActivity">

    <!-- ==================== GUIDELINES VERTICALES (MÁRGENES LATERALES DE 16dp) ==================== -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="16dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="16dp" />

    <!-- ==================== GUIDELINES HORIZONTALES (SECCIONES) ==================== -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glToolbarBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="56dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glBottomNavTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="56dp" />


    <!-- ==================== BARRA SUPERIOR (PLANA) ==================== -->
    <View
        android:id="@+id/bgToolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#6200EE"
        app:layout_constraintBottom_toTopOf="@id/glToolbarBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivMenu"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_sort_by_size"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@id/bgToolbar"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="TaskMate"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/bgToolbar"
        app:layout_constraintStart_toEndOf="@id/ivMenu"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivMore"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_more"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@id/bgToolbar"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivSearch"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_menu_search"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@id/bgToolbar"
        app:layout_constraintEnd_toStartOf="@id/ivMore"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ==================== SALUDO ==================== -->
    <TextView
        android:id="@+id/tvSaludo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Hola, Ana 👋"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/bgToolbar" />

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Hoy tienes 3 tareas pendientes"
        android:textColor="#757575"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/tvSaludo" />


    <!-- ==================== FILTROS SUPERIORES ==================== -->
    <Button
        android:id="@+id/btnTodas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Todas"
        android:textAllCaps="false"
        app:backgroundTint="#6200EE"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <Button
        android:id="@+id/btnPendientes"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Pendientes"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="@id/btnTodas"
        app:layout_constraintStart_toEndOf="@id/btnTodas"
        app:layout_constraintTop_toTopOf="@id/btnTodas"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <Button
        android:id="@+id/btnCompletadas"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Completadas"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="@id/btnTodas"
        app:layout_constraintStart_toEndOf="@id/btnPendientes"
        app:layout_constraintTop_toTopOf="@id/btnTodas"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />


    <!-- ==================== TAREAS (1 AL 4) ==================== -->

    <!-- TAREA 1 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTask1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/btnTodas">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <CheckBox
                android:id="@+id/cbTask1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTask1Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Estudiar Android XML"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/chipPriority1"
                app:layout_constraintStart_toEndOf="@id/cbTask1"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTask1Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:text="Hoy · 10:00"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/cbTask1"
                app:layout_constraintTop_toBottomOf="@id/tvTask1Title" />

            <TextView
                android:id="@+id/chipPriority1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#EDE7F6"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="Alta"
                android:textColor="#512DA8"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivMore1"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivMore1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_menu_more"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- TAREA 2 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTask2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/cardTask1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <CheckBox
                android:id="@+id/cbTask2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTask2Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Hacer ejercicio"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/chipPriority2"
                app:layout_constraintStart_toEndOf="@id/cbTask2"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTask2Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:text="Hoy · 18:00"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/cbTask2"
                app:layout_constraintTop_toBottomOf="@id/tvTask2Title" />

            <TextView
                android:id="@+id/chipPriority2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8F5E9"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="Media"
                android:textColor="#388E3C"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivMore2"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivMore2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_menu_more"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- TAREA 3 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTask3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/cardTask2">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <CheckBox
                android:id="@+id/cbTask3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTask3Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Leer un libro"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/chipPriority3"
                app:layout_constraintStart_toEndOf="@id/cbTask3"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTask3Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:text="Mañana · 09:00"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/cbTask3"
                app:layout_constraintTop_toBottomOf="@id/tvTask3Title" />

            <TextView
                android:id="@+id/chipPriority3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="Baja"
                android:textColor="#616161"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivMore3"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivMore3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_menu_more"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- TAREA 4 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTask4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/cardTask3">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <CheckBox
                android:id="@+id/cbTask4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTask4Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Preparar la presentación"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/chipPriority4"
                app:layout_constraintStart_toEndOf="@id/cbTask4"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTask4Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:text="Mañana · 12:00"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/cbTask4"
                app:layout_constraintTop_toBottomOf="@id/tvTask4Title" />

            <TextView
                android:id="@+id/chipPriority4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#EDE7F6"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="Alta"
                android:textColor="#512DA8"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivMore4"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivMore4"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_menu_more"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- ==================== BOTÓN FLOTANTE (+) ==================== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:contentDescription="Añadir"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#6200EE"
        app:layout_constraintBottom_toTopOf="@id/glBottomNavTop"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="@android:color/white" />


    <!-- ==================== BARRA DE NAVEGACIÓN INFERIOR (PLANA) ==================== -->
    <TextView
        android:id="@+id/navInicio"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="Inicio"
        android:textColor="#6200EE"
        android:textStyle="bold"
        android:drawableTop="@android:drawable/ic_menu_agenda"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/navTareas"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/glBottomNavTop" />

    <TextView
        android:id="@+id/navTareas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="Tareas"
        android:textColor="#757575"
        android:drawableTop="@android:drawable/ic_menu_agenda"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/navEstadisticas"
        app:layout_constraintStart_toEndOf="@id/navInicio"
        app:layout_constraintTop_toBottomOf="@id/glBottomNavTop" />

    <TextView
        android:id="@+id/navEstadisticas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="Estadísticas"
        android:textColor="#757575"
        android:drawableTop="@android:drawable/ic_menu_slideshow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/navPerfil"
        app:layout_constraintStart_toEndOf="@id/navTareas"
        app:layout_constraintTop_toBottomOf="@id/glBottomNavTop" />

    <TextView
        android:id="@+id/navPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="Perfil"
        android:textColor="#757575"
        android:drawableTop="@android:drawable/ic_menu_myplaces"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/navEstadisticas"
        app:layout_constraintTop_toBottomOf="@id/glBottomNavTop" />

</androidx.constraintlayout.widget.ConstraintLayout>