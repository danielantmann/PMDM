<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/black">


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.18" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTeam2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.70" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.99"/>


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottomBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.93" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTopBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.80" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.2" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeftBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.40" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeftBtnContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.34" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRightBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.60" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRightBtnContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.66" />




    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRightToEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.85"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlay"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:text="@string/play"
        android:textSize="@dimen/txt25sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white"
        android:padding="@dimen/_0dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginBottom="@dimen/margin_8dp"
        android:layout_marginStart="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineLeft"
        app:layout_constraintBottom_toTopOf="@id/guidelineTop"
        app:layout_constraintVertical_chainStyle="spread"
        app:cornerRadius="@dimen/_100dp"
        />

    <TextView
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/inicio_contador"
        android:textColor="@color/red"
        android:textSize="@dimen/text_75sp"
        app:layout_constraintBottom_toTopOf="@id/guidelineTop"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRightBtn"
        app:layout_constraintStart_toStartOf="@id/guidelineLeftBtn"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tiempo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_1_quarter"
        android:textColor="@color/white"
        android:textSize="@dimen/text_55sp"
        app:layout_constraintBottom_toTopOf="@id/guidelineTop"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRightToEnd"
        app:layout_constraintStart_toEndOf="@+id/timer"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMas1Team1"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:text="@string/plus1"
        android:textSize="@dimen/txt25sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white"
        android:padding="@dimen/_0dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginBottom="@dimen/margin_8dp"
        android:layout_marginStart="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        app:layout_constraintTop_toBottomOf="@id/guidelineTop"
        app:layout_constraintBottom_toTopOf="@id/btnMas2Team1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineLeft"
        app:layout_constraintVertical_chainStyle="spread"
        app:cornerRadius="@dimen/_100dp"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMas2Team1"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:text="@string/plus2"
        android:textSize="@dimen/txt25sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white"
        android:padding="@dimen/_0dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginBottom="@dimen/margin_8dp"
        android:layout_marginStart="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        app:layout_constraintTop_toBottomOf="@id/btnMas1Team1"
        app:layout_constraintBottom_toTopOf="@id/btnMas3Team1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineLeft"
        app:cornerRadius="@dimen/_100dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMas3Team1"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:layout_marginStart="@dimen/margin_8dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        android:backgroundTint="@color/white"
        android:padding="@dimen/_0dp"
        android:text="@string/plus3"
        android:textColor="@color/black"
        android:textSize="@dimen/txt25sp"
        app:cornerRadius="@dimen/_100dp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineTeam2"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/guidelineLeft"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMas2Team1" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMas1Team2"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        android:layout_marginBottom="@dimen/margin_8dp"
        android:backgroundTint="@color/white"
        android:padding="@dimen/_0dp"
        android:text="@string/plus1"
        android:textColor="@color/black"
        android:textSize="@dimen/txt25sp"
        app:cornerRadius="@dimen/_100dp"
        app:layout_constraintBottom_toTopOf="@id/btnMas2Team2"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guidelineRightToEnd"
        app:layout_constraintTop_toBottomOf="@id/guidelineTop"
        app:layout_constraintVertical_chainStyle="spread" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMas2Team2"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        android:layout_marginBottom="@dimen/margin_8dp"
        android:backgroundTint="@color/white"
        android:padding="@dimen/_0dp"
        android:text="@string/plus2"
        android:textColor="@color/black"
        android:textSize="@dimen/txt25sp"
        app:cornerRadius="100dp"
        app:layout_constraintBottom_toTopOf="@id/btnMas3Team2"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guidelineRightToEnd"
        app:layout_constraintTop_toBottomOf="@id/btnMas1Team2"
        app:layout_constraintVertical_chainStyle="spread" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMas3Team2"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        android:layout_marginBottom="@dimen/margin_8dp"
        android:backgroundTint="@color/white"
        android:padding="@dimen/_0dp"
        android:text="@string/plus3"
        android:textColor="@color/black"
        android:textSize="@dimen/txt25sp"
        app:cornerRadius="@dimen/_100dp"
        app:layout_constraintBottom_toTopOf="@id/guidelineTeam2"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guidelineRightToEnd"
        app:layout_constraintTop_toBottomOf="@id/btnMas2Team2"
        app:layout_constraintVertical_chainStyle="spread" />

    <TextView
        android:id="@+id/x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/x"
        android:textColor="@color/white"
        android:textSize="@dimen/text_55sp"
        app:layout_constraintEnd_toStartOf="@+id/puntosTeam_2"
        app:layout_constraintStart_toEndOf="@+id/puntosTeam_1"
        app:layout_constraintBottom_toBottomOf="@id/guidelineTeam2"
        app:layout_constraintTop_toBottomOf="@id/team1"/>

    <TextView
        android:id="@+id/team1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/equipo_1"
        android:textColor="@color/white"
        android:textSize="@dimen/txt_45sp"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/guidelineTop" />

    <TextView
        android:id="@+id/puntosTeam_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_0"
        android:textColor="@color/green"
        android:textSize="@dimen/txt_150sp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineTeam2"
        app:layout_constraintEnd_toStartOf="@+id/x"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/team1" />

    <TextView
        android:id="@+id/team2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/equipo_2"
        android:textColor="@color/white"
        android:textSize="@dimen/txt_45sp"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRightToEnd"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTop"
    />

    <TextView
        android:id="@+id/puntosTeam_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_0"
        android:textColor="@color/green"
        android:textSize="@dimen/txt_150sp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineTeam2"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRightToEnd"
        app:layout_constraintStart_toEndOf="@id/x"
        app:layout_constraintTop_toBottomOf="@+id/team2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMasFaltaTeam1"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:backgroundTint="@color/white"
        android:padding="@dimen/_0dp"
        android:text="@string/mas"
        android:textColor="@color/black"
        android:textSize="@dimen/txt25sp"
        app:cornerRadius="@dimen/_100dp"
        app:layout_constraintBottom_toTopOf="@id/guidelineBottomBtn"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@+id/guidelineLeftBtnContainer"
        app:layout_constraintEnd_toStartOf="@id/guidelineLeftBtn"
        app:layout_constraintTop_toBottomOf="@id/guidelineTopBtn"
        app:layout_constraintVertical_chainStyle="spread" />

    <TextView
        android:id="@+id/faltas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/faltas"
        android:textColor="@color/white"
        android:textSize="@dimen/txt_35sp"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRightBtn"
        app:layout_constraintStart_toEndOf="@+id/guidelineLeftBtn"
        app:layout_constraintTop_toBottomOf="@id/guidelineTeam2"
        app:layout_constraintBottom_toTopOf="@id/guidelineTopBtn"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMasFaltaTeam2"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:backgroundTint="@color/white"
        android:padding="@dimen/_0dp"
        android:text="@string/mas"
        android:textColor="@color/black"
        android:textSize="@dimen/txt25sp"
        app:cornerRadius="@dimen/_100dp"
        app:layout_constraintBottom_toTopOf="@id/guidelineBottomBtn"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/guidelineRightBtnContainer"
        app:layout_constraintStart_toEndOf="@id/guidelineRightBtn"
        app:layout_constraintTop_toBottomOf="@id/guidelineTopBtn"
        app:layout_constraintVertical_chainStyle="spread" />

    <TextView
        android:id="@+id/cantFaltasTeam1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cant_faltas_team1_0"
        android:textColor="@color/yellow"
        android:textSize="@dimen/txt_50sp"

        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomBtn"
        app:layout_constraintEnd_toStartOf="@+id/separadorFaltas"
        app:layout_constraintStart_toEndOf="@+id/guidelineLeftBtn"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopBtn" />

    <TextView
        android:id="@+id/separadorFaltas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/x"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/faltas"
        app:layout_constraintEnd_toStartOf="@id/cantFaltasTeam2"
        app:layout_constraintStart_toEndOf="@id/cantFaltasTeam1"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomBtn"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopBtn"
        />

    <TextView
        android:id="@+id/cantFaltasTeam2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/team2_puntos_0"
        android:textColor="@color/yellow"
        android:textSize="@dimen/txt_50sp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomBtn"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRightBtn"
        app:layout_constraintStart_toEndOf="@+id/separadorFaltas"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopBtn" />

    <Button
        android:id="@+id/buttonEditar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/blue"
        android:textColor="@color/white"
        android:text="@string/editar"
        app:layout_constraintBottom_toTopOf="@+id/guidelineTop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guidelineRightToEnd"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonCompartir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/blue"
        android:textColor="@color/white"
        android:text="@string/compartir"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineLeft"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guidelineBottomBtn"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopBtn" />

</androidx.constraintlayout.widget.ConstraintLayout>